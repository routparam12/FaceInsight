# Copy to .env and adjust. .env is git-ignored.

# --- App ---
APP_NAME=face-attendance
ENV=dev
LOG_LEVEL=INFO

# --- Database ---
# Dev/test default is sqlite; use asyncpg in production.
DATABASE_URL=sqlite+aiosqlite:///./face_attendance.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/face_attendance

# --- Admin auth (JWT) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=720

# --- Device auth ---
DEVICE_TOKEN_TTL_DAYS=90

# --- Face model ---
MODEL_VERSION=arcface-v1
EMBEDDING_DIM=512
# Path to an ONNX ArcFace model. If unset, a deterministic stub encoder is used
# (enrollment still works end to end for development, embeddings are not real).
FACE_MODEL_PATH=

# --- Recognition thresholds (cosine similarity) ---
ACCEPT_THRESHOLD=0.42
REVIEW_LOW_THRESHOLD=0.36
COLLISION_THRESHOLD=0.42
COLLISION_MARGIN=0.05

# --- Quality gates ---
MIN_FACE_SCORE=0.60
MIN_LIVENESS_SCORE=0.70

# --- Attendance rules ---
CLOCK_SKEW_SECONDS=120
DEBOUNCE_SECONDS=180
SHIFT_GRACE_MINUTES=60
ENFORCE_SHIFT_WINDOW=false
ENFORCE_SITE_MATCH=true

# --- Enrollment image storage ---
STORAGE_DIR=./app/storage/enrollment
# 32-byte urlsafe-base64 Fernet key. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENROLLMENT_ENCRYPTION_KEY=
